# Copy to .env and fill in. Never commit .env.
# App-only Bearer Token from console.x.com (app keys and tokens). Read-only use.
X_BEARER_TOKEN=
# Same value as X_BRIEF_KEY on the web service: /api/x-brief JSON for real DexiScan numbers.
X_BRIEF_KEY=
# Same value as API_READ_KEY on the web service: x-brief and Whale Radar (wallet lens).
# Read-only since hyperliquid_whales PR #137.
API_READ_KEY=
# @dexi_radar_bot token from @BotFather. Only the chat below may talk to the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
