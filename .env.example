# dexi_x_radar configuration. Copy to `.env` and fill in. Never commit `.env`.
# Required for every setup: X_*, TELEGRAM_*, MCP_TOKEN. Everything else has a default.

# ── X (console.x.com, pay-per-use) ─────────────────────────────────────────────
# App-only Bearer Token (your app → Keys and tokens). The radar only reads.
X_BEARER_TOKEN=
# The account whose mentions you answer and whose replies the radar matches to drafts.
X_OWN_HANDLE=DexiScan
# Seconds between polls. Cost does not depend on it (X bills per post read, not per
# request); it only sets how late a post can reach you.
POLL_INTERVAL_SECONDS=300
# Cost guard: at most this many posts read per source per poll.
MAX_POSTS_PER_POLL=40
# One handle per line, without @.
WATCHLIST_FILE=watchlist.txt

# ── Telegram (@BotFather → /newbot) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Your chat with the bot: send /start to it, then run `python -m dexi_x_radar chat-id`.
# The bot ignores every other chat.
TELEGRAM_CHAT_ID=

# ── MCP server (how Claude reads the queue and saves drafts) ───────────────────
# Shared secret Claude sends as `Authorization: Bearer <MCP_TOKEN>`. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=
# HTTP port of the service. Railway sets PORT itself.
PORT=8080

# ── Storage (the radar's own SQLite; it never touches any other database) ──────
# Local default: ./data/radar.db. On Railway, point it at the volume: /data/radar.db
DB_PATH=data/radar.db

# ── Optional: DexiScan data for drafts (only for a DexiScan deployment) ─────────
DEXISCAN_BASE_URL=https://dexiscan.com
# Same value as on the DexiScan web service. Both keys are read-only.
X_BRIEF_KEY=
API_READ_KEY=

# ── Optional, later: drafts written inside the service (no PC needed) ──────────
# Leave empty to draft with Claude Code on your own machine (subscription).
ANTHROPIC_API_KEY=
DRAFT_MODEL=claude-sonnet-5-5
